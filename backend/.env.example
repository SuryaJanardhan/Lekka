PORT=5000
MONGODB_URI=mongodb://localhost:27017/lekka_db
GROQ_API_KEY=your_groq_api_key

# Direct Gmail + App Password Setup (Easiest Method)
GMAIL_USER=your_gmail_address@gmail.com
