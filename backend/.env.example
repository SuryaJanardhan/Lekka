PORT=5000
MONGODB_URI=mongodb+srv://app_writer:<encoded-password>@<cluster-host>/test?authSource=admin
# Separate Atlas user with read privilege on the production database. Never reuse the writer.
MONGODB_READONLY_URI=mongodb+srv://lekka_ai_reader:<encoded-password>@<cluster-host>/test?authSource=admin
GROQ_API_KEY=your_groq_api_key
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# API Security Secret (Required for all API calls)
LEKKA_API_SECRET=your_random_secret_token_here
CRON_SECRET=your_random_secret_token_here

# Direct Gmail App Password Setup
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Target Senders Filter (comma separated)
TARGET_SENDER_EMAILS=billing@company.com,invoices@vendor.com
# Exact personal addresses permitted to forward selected bank messages.
TRUSTED_FORWARDER_EMAILS=
# Optional private Gmail plus-address; also requires [LEKKA TEST] in the subject.
INGESTION_TEST_RECIPIENT=
INGESTION_CRON_SCHEDULE=30 18 * * *
GMAIL_IMAP_SCAN_LIMIT=300
GMAIL_INGEST_LIMIT=50
# Firebase service-account JSON for Vercel-to-Android remote push.
FIREBASE_SERVICE_ACCOUNT_JSON=
