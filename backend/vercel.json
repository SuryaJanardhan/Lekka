{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.ts": { "maxDuration": 60 },
    "api/operations-worker.ts": {
      "maxDuration": 60,
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "lekka-operations" }]
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/", "destination": "/api/index" }
  ],
  "crons": [
    {
      "path": "/api/ingest",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/notifications/digest?kind=morning",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/notifications/digest?kind=evening",
      "schedule": "30 15 * * *"
    }
  ]
}
