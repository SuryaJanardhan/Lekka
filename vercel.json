{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/ingest",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/notifications/digest?kind=morning",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/notifications/digest?kind=evening",
      "schedule": "30 15 * * *"
    }
  ]
}
