{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/server.ts"
    },
    {
      "src": "/health",
      "dest": "backend/src/server.ts"
    },
    {
      "src": "/(.*)",
      "dest": "backend/src/server.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/ingest",
      "schedule": "0 12 * * *"
    }
  ]
}
